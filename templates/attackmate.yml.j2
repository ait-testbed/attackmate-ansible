###
{%- if attackmate_sliver_config is defined %}

sliver_config:
  config_file: {{ attackmate_sliver_config }}
{% endif %}

{%- if attackmate_msf_server is defined %}

msf_config:
  server: {{ attackmate_msf_server }}
  {%- if attackmate_msf_passwd %}
  
  password: {{ attackmate_msf_passwd }}
  {% endif %}
{% endif %}


{%- if command_delay is defined %}

cmd_config:
  command_delay: {{ command_delay }}
{% endif %}

{% if attackmate_remote_config %}
remote_config:
{% for name, conn in attackmate_remote_config.items() %}
  {{ name }}:
    url: "{{ conn.url }}"
    username: {{ conn.username }}
    password: {{ conn.password }}
{% if conn.cafile is defined %}
    cafile: "{{ conn.cafile }}"
{% endif %}
{% endfor %}
{% endif %}